{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/patterns/**",
              "site/**",
              "ui_kits/dashboard/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Mono|IBM Plex Sans))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Mono, IBM Plex Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Person'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|initials|src|key|ref|className|style|children)$/]",
        "message": "<Person> doesn't accept that prop. Declared props: name, initials, src."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|dot|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, size, dot."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|accent|success|warning|danger|neutral|solid|on-dark)$/]",
        "message": "<Badge> tone must be one of 'brand' | 'accent' | 'success' | 'warning' | 'danger' | 'neutral' | 'solid' | 'on-dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|iconLeft|iconRight|fullWidth|disabled|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, iconLeft, iconRight, fullWidth, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|brand|accent|secondary|ghost|on-dark)$/]",
        "message": "<Button> variant must be one of 'primary' | 'brand' | 'accent' | 'secondary' | 'ghost' | 'on-dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:surface|interactive|pattern|padding|radius|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: surface, interactive, pattern, padding, radius."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:default|muted|brand|dark|outline)$/]",
        "message": "<Card> surface must be one of 'default' | 'muted' | 'brand' | 'dark' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|description|checked|defaultChecked|disabled|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, description, checked, defaultChecked, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContourField'] > JSXAttribute > JSXIdentifier[name!=/^(?:motif|tone|density|globeSize|opacity|key|ref|className|style|children)$/]",
        "message": "<ContourField> doesn't accept that prop. Declared props: motif, tone, density, globeSize, opacity."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContourField'] > JSXAttribute[name.name='motif'] > Literal[value!=/^(?:contour|ridge|orbit)$/]",
        "message": "<ContourField> motif must be one of 'contour' | 'ridge' | 'orbit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContourField'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:on-brand|on-light|on-accent|on-dark)$/]",
        "message": "<ContourField> tone must be one of 'on-brand' | 'on-light' | 'on-accent' | 'on-dark'."
