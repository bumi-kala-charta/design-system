        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|shape|label|disabled|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: variant, size, shape, label, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:soft|soft-accent|solid|outline|ghost|on-dark)$/]",
        "message": "<IconButton> variant must be one of 'soft' | 'soft-accent' | 'solid' | 'outline' | 'ghost' | 'on-dark'."
      },
